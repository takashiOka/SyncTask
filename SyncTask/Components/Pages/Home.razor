@page "/"
@using System.Globalization

<div class="daily-page">
    <section class="daily-page__hero glass-card">
        <div>
            <h1>デイリー管理</h1>
            <p class="daily-page__subtitle">勤務報告の作成と Redmine 実工数登録を一画面で管理</p>
        </div>
        <div class="daily-page__badges">
            <span class="daily-badge">対象日 @workDate.ToString("yyyy/MM/dd")</span>
            <span class="daily-badge">タスク @entries.Count(x => !IsEntryEmpty(x)) 件</span>
            <span class="daily-badge">実工数 @FormatHours(entries.Sum(x => x.ActualHours)) h</span>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(redmineStatusMessage))
    {
        <div class="daily-status glass-card">@redmineStatusMessage</div>
    }

    <div class="daily-grid">
        <section class="daily-card glass-card daily-card--full">
            <h2>作業入力</h2>
            <div class="daily-log__table-wrap">
                <table class="daily-log__table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>プロジェクト</th>
                            <th>ストーリー</th>
                            <th>タスク</th>
                            <th class="daily-grid-head--plan">工数(予)</th>
                            <th class="daily-grid-head--plan">開始(予)</th>
                            <th class="daily-grid-head--plan">終了(予)</th>
                            <th class="daily-grid-head--actual">開始(実)</th>
                            <th class="daily-grid-head--actual">終了(実)</th>
                            <th class="daily-grid-head--actual">工数(実)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="daily-log-tbody">
                        @for (var index = 0; index < entries.Count; index++)
                        {
                            var entry = entries[index];
                            var stories = GetStoryOptions(entry);
                            var tasks = GetTaskOptions(entry);

                            <tr @key="entry"
                                data-row-index="@index"
                                class="@GetRowClass(entry, index)">
                                <td>
                                    <i class="bi bi-grip-vertical drag-handle"
                                        onpointerdown="window.syncTaskDnd && window.syncTaskDnd.startPointerDrag(event)"></i>
                                </td>
                                <td>
                                    <select value="@GetProjectSelectValue(entry)"
                                            title="@GetProjectSelectTitle(entry)"
                                            @onchange="async args => await OnGridProjectChangedAsync(entry, args)"
                                            @onblur="async _ => await SaveGridRowAsync(entry)">
                                        <option value="">プロジェクトを選択</option>
                                        <option value="@BreakProjectOptionValue">@BreakProjectName</option>
                                        @foreach (var project in GetProjectOptions(entry))
                                        {
                                            <option value="@project.Id" selected="@(entry.RedmineProjectId == project.Id)">@project.Name</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select value="@(entry.RedmineStoryIssueId?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)"
                                            title="@GetStorySelectTitle(entry)"
                                            @onchange="args => OnGridStoryChanged(entry, args)"
                                            @onblur="async _ => await SaveGridRowAsync(entry)"
                                            disabled="@(!entry.RedmineProjectId.HasValue)">
                                        <option value="">ストーリーを選択</option>
                                        @foreach (var issue in stories)
                                        {
                                            <option value="@issue.Id" title="@issue.Id @issue.Subject">#@issue.Id @issue.Subject</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select value="@(entry.RedmineTaskIssueId?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)"
                                            title="@GetTaskSelectTitle(entry)"
                                            @onchange="args => OnGridTaskChanged(entry, args)"
                                            @onblur="async _ => await SaveGridRowAsync(entry)"
                                            disabled="@(!entry.RedmineProjectId.HasValue || !entry.RedmineStoryIssueId.HasValue)">
                                        <option value="">タスクを選択</option>
                                        @foreach (var issue in tasks)
                                        {
                                            <option value="@issue.Id" title="@issue.Id @issue.Subject">#@issue.Id @issue.Subject</option>
                                        }
                                    </select>
                                </td>
                                <td class="daily-grid-cell--plan">
                                    <input type="number"
                                           min="0"
                                           step="0.25"
                                           value="@ToInputDecimal(entry.PlannedHours)"
                                           @oninput="args => OnGridPlannedHoursChanged(entry, args)"
                                           @onblur="async _ => await SaveGridRowAsync(entry)" />
                                </td>
                                <td class="daily-grid-cell--plan">
                                    <input type="time"
                                           step="900"
                                           value="@ToInputTime(entry.StartTime)"
                                           @oninput="args => OnGridStartTimeChanged(entry, args)"
                                           @onblur="async _ => await SaveGridRowAsync(entry)"
                                           disabled="@(index > 0)" />
                                </td>
                                <td class="daily-grid-cell--readonly daily-grid-cell--plan">
                                    <input type="text"
                                           value="@FormatTime(entry.PlannedEndTime)"
                                           disabled />
                                </td>
                                <td class="daily-grid-cell--actual">
                                    <input type="time"
                                           value="@ToInputTime(entry.ActualStartTime)"
                                           @oninput="args => OnGridActualStartTimeChanged(entry, args)"
                                           @onblur="async _ => await SaveGridRowAsync(entry)"
                                           disabled="@(index > 0)" />
                                </td>
                                <td class="daily-grid-cell--actual">
                                    <input type="time"
                                           value="@ToInputTime(entry.ActualEndTime)"
                                           @oninput="args => OnGridActualEndTimeChanged(entry, args)"
                                           @onblur="async _ => await SaveGridRowAsync(entry)" />
                                </td>
                                <td class="daily-grid-cell--readonly daily-grid-cell--actual">
                                    <input type="text"
                                           value="@FormatHours(entry.ActualHours)"
                                           disabled />

                                </td>
                                <td>
                                    @if (!IsEntryEmpty(entry))
                                    {
                                        <div class="daily-row-actions">
                                            <button class="btn btn--ghost daily-action-btn"
                                                    title="行を挿入"
                                                    aria-label="行を挿入"
                                                    @onclick="() => InsertGridRowAsync(entry)">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                            <button class="btn btn--danger daily-action-btn"
                                                    title="行を削除"
                                                    aria-label="行を削除"
                                                    @onclick="() => DeleteGridRowAsync(entry)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="daily-card glass-card daily-card--full">
            <div class="daily-card__title-row">
                <h2>勤務報告メール本文</h2>
                <span class="daily-badge">Becky!2 貼り付け向けプレビュー</span>
            </div>

            <div class="daily-log__entry">
                <button class="btn btn--primary" @onclick="GenerateMailBodyAsync">本文生成</button>
                <button class="btn btn--ghost" @onclick="CopyMailBodyAsync" disabled="@string.IsNullOrWhiteSpace(generatedMailBody)">本文をコピー</button>
                @* <button class="btn" @onclick="ComposeWorkReportMailAsync" disabled="@string.IsNullOrWhiteSpace(generatedMailBody)">メール作成</button> *@
                <button class="btn btn--ghost" @onclick="ComposeWorkReportMailAsync" disabled="true">メール作成</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(generatedMailBody))
            {
                <textarea class="daily-log__mail-preview" readonly>@generatedMailBody</textarea>
            }
            else
            {
                <div class="daily-log__mail-empty">本文生成を押すと、ここにメール本文が表示されます。</div>
            }
        </section>

        <section class="daily-card glass-card daily-card--full">
            <h2>Redmine連携</h2>
            <div class="daily-log__entry">
                <button class="btn btn--primary" @onclick="RegisterSpentTimeToRedmineAsync" disabled="@isLoadingRedmine">一日の実工数をRedmineへ一括登録</button>
            </div>
        </section>
    </div>
</div>

