@page "/attendance"

<div class="attendance-page daily-page">
    <section class="daily-page__hero glass-card attendance-hero">
        <div>
            <h1>出勤簿</h1>
            <p class="daily-page__subtitle">月次の出勤・退勤と労働時間を一覧で確認</p>
        </div>
        <div class="attendance-month-picker">
            <button class="btn btn--ghost" @onclick="() => MoveMonthAsync(-1)">前月</button>
            <input type="month" value="@TargetMonthInput" @onchange="OnMonthChangedAsync" />
            <button class="btn btn--ghost" @onclick="() => MoveMonthAsync(1)">次月</button>
        </div>
    </section>

    <div class="daily-status glass-card">@PeriodLabel</div>

    @if (ShowReminder)
    {
        <div class="attendance-reminder glass-card">
            <span class="attendance-reminder__icon">🔔</span>
            <span class="attendance-reminder__text">
                今月は21日を過ぎています。<strong>出勤簿の出力</strong>をお忘れなく！
            </span>
            <button class="attendance-reminder__close" @onclick="DismissReminder" title="閉じる">×</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="daily-status glass-card">@statusMessage</div>
    }

    <section class="daily-card glass-card attendance-sheet">
        <div class="attendance-sheet__table-wrap">
            <table class="daily-log__table attendance-table">
                <thead>
                    <tr>
                        <th>日付</th>
                        <th>曜日</th>
                        <th>出勤</th>
                        <th>出勤時刻</th>
                        <th>退勤時刻</th>
                        <th>勤務時間合計</th>
                        <th>保存</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var day in editableDays)
                    {
                        <tr class="@GetDayRowClass(day.Date)">
                            <td>@day.Date.ToString("MM/dd")</td>
                            <td>@GetWeekdayLabel(day.Date)</td>
                            <td>@(day.HasAttendance ? "◯" : string.Empty)</td>
                            <td>
                                <input class="attendance-input attendance-input--time"
                                       type="time"
                                       step="60"
                                       value="@day.StartTimeInput"
                                       @oninput="args => OnStartTimeInputChanged(day, args)" />
                            </td>
                            <td>
                                <input class="attendance-input attendance-input--time"
                                       type="time"
                                       step="60"
                                       value="@day.EndTimeInput"
                                       @oninput="args => OnEndTimeInputChanged(day, args)" />
                            </td>
                            <td>
                                <input class="attendance-input attendance-input--hours"
                                       type="number"
                                       min="0"
                                       step="0.25"
                                       value="@day.WorkingHoursInput"
                                       @oninput="args => OnWorkingHoursInputChanged(day, args)" />
                            </td>
                            <td>
                                <button class="btn btn--ghost"
                                        @onclick="() => SaveDayAsync(day)"
                                        disabled="@day.IsSaving">保存</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="attendance-sheet__summary">
            <span class="daily-badge">実労働日数 @WorkingDays 日</span>
            <span class="daily-badge">総労働時間 @FormatHours(TotalWorkingHours) h</span>
            <button class="btn btn--primary" @onclick="GenerateExcelAsync" disabled="@isGenerating">
                @(isGenerating ? "生成中…" : "出勤簿生成")
            </button>
        </div>
    </section>

    <section class="daily-card glass-card attendance-sheet">
        <div class="attendance-redmine-header">
            <h2 class="attendance-redmine-title">プロジェクト別工数（Redmine）</h2>
            <button class="btn btn--ghost" @onclick="LoadRedmineHoursAsync" disabled="@isLoadingRedmine">
                @(isLoadingRedmine ? "取得中…" : "Redmine工数を取得")
            </button>
        </div>

        @if (projectHours.Count > 0)
        {
            <div class="attendance-project-table-wrap">
                <table class="daily-log__table attendance-project-table">
                    <thead>
                        <tr>
                            <th>プロジェクト</th>
                            <th>工数 (h)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in projectHours)
                        {
                            <tr>
                                <td class="attendance-project-name">@entry.ProjectName</td>
                                <td>@entry.Hours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="attendance-project-total">
                            <td>合計</td>
                            <td>@projectHours.Sum(e => e.Hours).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>
</div>
